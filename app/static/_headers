# Cloudflare Pages / Netlify cache headers.
# Content-hashed files never change: fetched exactly once per reader.

/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=31536000, immutable

# Mutable pointers stay fresh.
/data/catalog.json
  Cache-Control: public, max-age=300
/data/sources.json
  Cache-Control: public, max-age=300
/manifest.webmanifest
  Cache-Control: public, max-age=3600
