		<dc:title id="title">Pericles</dc:title>
		<meta property="file-as" refines="#title">Pericles</meta>
		<meta property="dcterms:alternative" refines="#title">Pericles, Prince of Tyre</meta>
		<dc:subject id="subject-1">Tragicomedy</dc:subject>
		<dc:subject id="subject-2">Princes -- Lebanon -- Tyre -- Drama</dc:subject>
		<dc:subject id="subject-3">Tyre (Lebanon) -- Drama</dc:subject>
		<meta property="authority" refines="#subject-1">LCSH</meta>
