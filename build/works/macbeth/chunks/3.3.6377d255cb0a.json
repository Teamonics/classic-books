{"schema":1,"ref":"3.3","work":"macbeth","title":"Act 3, Scene 3","prev":"3.2","next":"3.4","blocks":[{"type":"stage","text":"A park near the palace."},{"type":"stage","text":"Enter three Murderers.","marks":[{"s":12,"e":21,"k":"strong"}]},{"type":"speech","speaker":"First Murderer","blocks":[{"type":"verse","lines":[{"n":1,"text":"But who did bid thee join with us?"}]}]},{"type":"speech","speaker":"Third Murderer","blocks":[{"type":"verse","lines":[{"n":2,"text":"Macbeth."}]}]},{"type":"speech","speaker":"Second Murderer","blocks":[{"type":"verse","lines":[{"n":3,"text":"He needs not our mistrust, since he delivers"},{"n":4,"text":"Our offices and what we have to do"},{"n":5,"text":"To the direction just."}]}]},{"type":"speech","speaker":"First Murderer","blocks":[{"type":"verse","lines":[{"n":6,"text":"Then stand with us."},{"n":7,"text":"The west yet glimmers with some streaks of day:"},{"n":8,"text":"Now spurs the lated traveller apace"},{"n":9,"text":"To gain the timely inn; and near approaches"},{"n":10,"text":"The subject of our watch."}]}]},{"type":"speech","speaker":"Third Murderer","blocks":[{"type":"verse","lines":[{"n":11,"text":"Hark! I hear horses."}]}]},{"type":"speech","speaker":"Banquo","blocks":[{"type":"verse","lines":[{"n":12,"text":"Within. Give us a light there, ho!","marks":[{"s":0,"e":7,"k":"em"}]}]}]},{"type":"speech","speaker":"Second Murderer","blocks":[{"type":"verse","lines":[{"n":13,"text":"Then ’tis he: the rest"},{"n":14,"text":"That are within the note of expectation"},{"n":15,"text":"Already are i’ the court."}]}]},{"type":"speech","speaker":"First Murderer","blocks":[{"type":"verse","lines":[{"n":16,"text":"His horses go about."}]}]},{"type":"speech","speaker":"Third Murderer","blocks":[{"type":"verse","lines":[{"n":17,"text":"Almost a mile: but he does usually,"},{"n":18,"text":"So all men do, from hence to the palace gate"},{"n":19,"text":"Make it their walk."}]}]},{"type":"speech","speaker":"Second Murderer","blocks":[{"type":"verse","lines":[{"n":20,"text":"A light, a light!"}]}]},{"type":"stage","text":"Enter Banquo, and Fleance with a torch.","marks":[{"s":6,"e":12,"k":"strong"},{"s":18,"e":25,"k":"strong"}]},{"type":"speech","speaker":"Third Murderer","blocks":[{"type":"verse","lines":[{"n":21,"text":"’Tis he."}]}]},{"type":"speech","speaker":"First Murderer","blocks":[{"type":"verse","lines":[{"n":22,"text":"Stand to’t."}]}]},{"type":"speech","speaker":"Banquo","blocks":[{"type":"verse","lines":[{"n":23,"text":"It will be rain to-night."}]}]},{"type":"speech","speaker":"First Murderer","blocks":[{"type":"verse","lines":[{"n":24,"text":"Let it come down. They set upon Banquo.","marks":[{"s":32,"e":38,"k":"strong"},{"s":18,"e":39,"k":"em"}]}]}]},{"type":"speech","speaker":"Banquo","blocks":[{"type":"verse","lines":[{"n":25,"text":"O, treachery! Fly, good Fleance, fly, fly, fly!"},{"n":26,"text":"Thou mayst revenge. O slave! Dies. Fleance escapes.","marks":[{"s":35,"e":42,"k":"strong"},{"s":29,"e":51,"k":"em"}]}]}]},{"type":"speech","speaker":"Third Murderer","blocks":[{"type":"verse","lines":[{"n":27,"text":"Who did strike out the light?"}]}]},{"type":"speech","speaker":"First Murderer","blocks":[{"type":"verse","lines":[{"n":28,"text":"Was’t not the way?"}]}]},{"type":"speech","speaker":"Third Murderer","blocks":[{"type":"verse","lines":[{"n":29,"text":"There’s but one down; the son is fled."}]}]},{"type":"speech","speaker":"Second Murderer","blocks":[{"type":"verse","lines":[{"n":30,"text":"We have lost"},{"n":31,"text":"Best half of our affair."}]}]},{"type":"speech","speaker":"First Murderer","blocks":[{"type":"verse","lines":[{"n":32,"text":"Well, let’s away, and say how much is done. Exeunt.","marks":[{"s":44,"e":51,"k":"em"}]}]}]}]}