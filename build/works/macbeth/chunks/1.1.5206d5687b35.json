{"schema":1,"ref":"1.1","work":"macbeth","title":"Act 1, Scene 1","prev":"dramatis-personae","next":"1.2","blocks":[{"type":"stage","text":"A desert place."},{"type":"stage","text":"Thunder and lightning. Enter three Witches.","marks":[{"s":35,"e":42,"k":"strong"}]},{"type":"speech","speaker":"First Witch","blocks":[{"type":"verse","lines":[{"n":1,"text":"When shall we three meet again"},{"n":2,"text":"In thunder, lightning, or in rain?"}]}]},{"type":"speech","speaker":"Second Witch","blocks":[{"type":"verse","lines":[{"n":3,"text":"When the hurlyburly’s done,"},{"n":4,"text":"When the battle’s lost and won."}]}]},{"type":"speech","speaker":"Third Witch","blocks":[{"type":"verse","lines":[{"n":5,"text":"That will be ere the set of sun."}]}]},{"type":"speech","speaker":"First Witch","blocks":[{"type":"verse","lines":[{"n":6,"text":"Where the place?"}]}]},{"type":"speech","speaker":"Second Witch","blocks":[{"type":"verse","lines":[{"n":7,"text":"Upon the heath."}]}]},{"type":"speech","speaker":"Third Witch","blocks":[{"type":"verse","lines":[{"n":8,"text":"There to meet with Macbeth."}]}]},{"type":"speech","speaker":"First Witch","blocks":[{"type":"verse","lines":[{"n":9,"text":"I come, Graymalkin!"}]}]},{"type":"speech","speaker":"Second Witch","blocks":[{"type":"verse","lines":[{"n":10,"text":"Paddock calls."}]}]},{"type":"speech","speaker":"Third Witch","blocks":[{"type":"verse","lines":[{"n":11,"text":"Anon."}]}]},{"type":"speech","speaker":"All","blocks":[{"type":"verse","lines":[{"n":12,"text":"Fair is foul, and foul is fair:"},{"n":13,"text":"Hover through the fog and filthy air. Exeunt.","marks":[{"s":38,"e":45,"k":"em"}]}]}]}]}