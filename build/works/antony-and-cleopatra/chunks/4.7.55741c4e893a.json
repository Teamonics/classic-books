{"schema":1,"ref":"4.7","work":"antony-and-cleopatra","title":"Act 4, Scene 7","prev":"4.6","next":"4.8","blocks":[{"type":"stage","text":"Field of battle between the camps."},{"type":"stage","text":"Alarum. Drums and trumpets. Enter Agrippa and others.","marks":[{"s":34,"e":41,"k":"strong"}]},{"type":"speech","speaker":"Agrippa","blocks":[{"type":"verse","lines":[{"n":1,"text":"Retire, we have engaged ourselves too far:"},{"n":2,"text":"Caesar himself has work, and our oppression"},{"n":3,"text":"Exceeds what we expected. Exeunt.","marks":[{"s":26,"e":33,"k":"em"}]}]}]},{"type":"stage","text":"Alarums. Enter Antony, and Scarus wounded.","marks":[{"s":15,"e":21,"k":"strong"},{"s":27,"e":33,"k":"strong"}]},{"type":"speech","speaker":"Scarus","blocks":[{"type":"verse","lines":[{"n":4,"text":"O my brave emperor, this is fought indeed!"},{"n":5,"text":"Had we done so at first, we had droven them home"},{"n":6,"text":"With clouts about their heads."}]}]},{"type":"speech","speaker":"Antony","blocks":[{"type":"verse","lines":[{"n":7,"text":"Thou bleed’st apace."}]}]},{"type":"speech","speaker":"Scarus","blocks":[{"type":"verse","lines":[{"n":8,"text":"I had a wound here that was like a T,"},{"n":9,"text":"But now ’tis made an H."}]}]},{"type":"speech","speaker":"Antony","blocks":[{"type":"verse","lines":[{"n":10,"text":"They do retire."}]}]},{"type":"speech","speaker":"Scarus","blocks":[{"type":"verse","lines":[{"n":11,"text":"We’ll beat ’em into bench-holes: I have yet"},{"n":12,"text":"Room for six scotches more."}]}]},{"type":"stage","text":"Enter Eros.","marks":[{"s":6,"e":10,"k":"strong"}]},{"type":"speech","speaker":"Eros","blocks":[{"type":"verse","lines":[{"n":13,"text":"They are beaten, sir; and our advantage serves"},{"n":14,"text":"For a fair victory."}]}]},{"type":"speech","speaker":"Scarus","blocks":[{"type":"verse","lines":[{"n":15,"text":"Let us score their backs,"},{"n":16,"text":"And snatch ’em up, as we take hares, behind:"},{"n":17,"text":"’Tis sport to maul a runner."}]}]},{"type":"speech","speaker":"Antony","blocks":[{"type":"verse","lines":[{"n":18,"text":"I will reward thee"},{"n":19,"text":"Once for thy spritely comfort, and ten-fold"},{"n":20,"text":"For thy good valour. Come thee on."}]}]},{"type":"speech","speaker":"Scarus","blocks":[{"type":"verse","lines":[{"n":21,"text":"I’ll halt after. Exeunt.","marks":[{"s":17,"e":24,"k":"em"}]}]}]}]}