{"schema":1,"ref":"4.3","work":"antony-and-cleopatra","title":"Act 4, Scene 3","prev":"4.2","next":"4.4","blocks":[{"type":"stage","text":"The same. Before the palace."},{"type":"stage","text":"Enter two Soldiers to their guard.","marks":[{"s":10,"e":18,"k":"strong"}]},{"type":"speech","speaker":"First Soldier","blocks":[{"type":"verse","lines":[{"n":1,"text":"Brother, good night: to-morrow is the day."}]}]},{"type":"speech","speaker":"Second Soldier","blocks":[{"type":"verse","lines":[{"n":2,"text":"It will determine one way: fare you well."},{"n":3,"text":"Heard you of nothing strange about the streets?"}]}]},{"type":"speech","speaker":"First Soldier","blocks":[{"type":"verse","lines":[{"n":4,"text":"Nothing. What news?"}]}]},{"type":"speech","speaker":"Second Soldier","blocks":[{"type":"verse","lines":[{"n":5,"text":"Belike ’tis but a rumour. Good night to you."}]}]},{"type":"speech","speaker":"First Soldier","blocks":[{"type":"verse","lines":[{"n":6,"text":"Well, sir, good night."}]}]},{"type":"stage","text":"Enter two other Soldiers.","marks":[{"s":16,"e":24,"k":"strong"}]},{"type":"speech","speaker":"Second Soldier","blocks":[{"type":"verse","lines":[{"n":7,"text":"Soldiers, have careful watch."}]}]},{"type":"speech","speaker":"Third Soldier","blocks":[{"type":"para","n":1,"text":"And you. Good night, good night. They place themselves in every corner of the stage.","marks":[{"s":33,"e":84,"k":"em"}]}]},{"type":"speech","speaker":"Fourth Soldier","blocks":[{"type":"verse","lines":[{"n":8,"text":"Here we: and if to-morrow"},{"n":9,"text":"Our navy thrive, I have an absolute hope"},{"n":10,"text":"Our landmen will stand up."}]}]},{"type":"speech","speaker":"Third Soldier","blocks":[{"type":"verse","lines":[{"n":11,"text":"’Tis a brave army,"},{"n":12,"text":"And full of purpose. Music of the hautboys as under the stage.","marks":[{"s":21,"e":62,"k":"em"}]}]}]},{"type":"speech","speaker":"Fourth Soldier","blocks":[{"type":"verse","lines":[{"n":13,"text":"Peace! what noise?"}]}]},{"type":"speech","speaker":"First Soldier","blocks":[{"type":"verse","lines":[{"n":14,"text":"List, list!"}]}]},{"type":"speech","speaker":"Second Soldier","blocks":[{"type":"verse","lines":[{"n":15,"text":"Hark!"}]}]},{"type":"speech","speaker":"First Soldier","blocks":[{"type":"verse","lines":[{"n":16,"text":"Music i’ the air."}]}]},{"type":"speech","speaker":"Third Soldier","blocks":[{"type":"verse","lines":[{"n":17,"text":"Under the earth."}]}]},{"type":"speech","speaker":"Fourth Soldier","blocks":[{"type":"verse","lines":[{"n":18,"text":"It signs well, does it not?"}]}]},{"type":"speech","speaker":"Third Soldier","blocks":[{"type":"verse","lines":[{"n":19,"text":"No."}]}]},{"type":"speech","speaker":"First Soldier","blocks":[{"type":"verse","lines":[{"n":20,"text":"Peace, I say!"},{"n":21,"text":"What should this mean?"}]}]},{"type":"speech","speaker":"Second Soldier","blocks":[{"type":"verse","lines":[{"n":22,"text":"’Tis the god Hercules, whom Antony loved,"},{"n":23,"text":"Now leaves him."}]}]},{"type":"speech","speaker":"First Soldier","blocks":[{"type":"verse","lines":[{"n":24,"text":"Walk; let’s see if other watchmen"},{"n":25,"text":"Do hear what we do? They advance to another post.","marks":[{"s":20,"e":49,"k":"em"}]}]}]},{"type":"speech","speaker":"Second Soldier","blocks":[{"type":"verse","lines":[{"n":26,"text":"How now, masters!"}]}]},{"type":"speech","speaker":"All","blocks":[{"type":"verse","lines":[{"n":27,"text":"Speaking together. How now!","marks":[{"s":0,"e":18,"k":"em"}]},{"n":28,"text":"How now! do you hear this?"}]}]},{"type":"speech","speaker":"First Soldier","blocks":[{"type":"verse","lines":[{"n":29,"text":"Ay; is’t not strange?"}]}]},{"type":"speech","speaker":"Third Soldier","blocks":[{"type":"verse","lines":[{"n":30,"text":"Do you hear, masters? do you hear?"}]}]},{"type":"speech","speaker":"First Soldier","blocks":[{"type":"verse","lines":[{"n":31,"text":"Follow the noise so far as we have quarter;"},{"n":32,"text":"Let’s see how it will give off."}]}]},{"type":"speech","speaker":"All","blocks":[{"type":"verse","lines":[{"n":33,"text":"Content. ’Tis strange. Exeunt.","marks":[{"s":23,"e":30,"k":"em"}]}]}]}]}