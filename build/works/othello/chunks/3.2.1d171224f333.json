{"schema":1,"ref":"3.2","work":"othello","title":"Act 3, Scene 2","prev":"3.1","next":"3.3","blocks":[{"type":"stage","text":"A room in the castle."},{"type":"stage","text":"Enter Othello, Iago, and Gentlemen.","marks":[{"s":6,"e":13,"k":"strong"},{"s":15,"e":19,"k":"strong"},{"s":25,"e":35,"k":"strong"}]},{"type":"speech","speaker":"Othello","blocks":[{"type":"verse","lines":[{"n":1,"text":"These letters give, Iago, to the pilot;"},{"n":2,"text":"And by him do my duties to the senate:"},{"n":3,"text":"That done, I will be walking on the works;"},{"n":4,"text":"Repair there to me."}]}]},{"type":"speech","speaker":"Iago","blocks":[{"type":"verse","lines":[{"n":5,"text":"Well, my good lord, I’ll do’t."}]}]},{"type":"speech","speaker":"Othello","blocks":[{"type":"verse","lines":[{"n":6,"text":"This fortification, gentlemen, shall we see’t?"}]}]},{"type":"speech","speaker":"Gentlemen","blocks":[{"type":"verse","lines":[{"n":7,"text":"We’ll wait upon your lordship. Exeunt.","marks":[{"s":31,"e":38,"k":"em"}]}]}]}]}