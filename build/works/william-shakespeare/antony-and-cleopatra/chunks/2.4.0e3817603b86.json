{"schema":1,"ref":"2.4","work":"antony-and-cleopatra","title":"Act 2, Scene 4","prev":"2.3","next":"2.5","blocks":[{"type":"stage","text":"The same. A street."},{"type":"stage","text":"Enter Lepidus, Mecaenas, and Agrippa.","marks":[{"s":6,"e":13,"k":"strong"},{"s":15,"e":23,"k":"strong"},{"s":29,"e":36,"k":"strong"}]},{"type":"speech","speaker":"Lepidus","blocks":[{"type":"verse","lines":[{"n":1,"text":"Trouble yourselves no further: pray you, hasten"},{"n":2,"text":"Your generals after."}]}]},{"type":"speech","speaker":"Agrippa","blocks":[{"type":"verse","lines":[{"n":3,"text":"Sir, Mark Antony"},{"n":4,"text":"Will e’en but kiss Octavia, and we’ll follow."}]}]},{"type":"speech","speaker":"Lepidus","blocks":[{"type":"verse","lines":[{"n":5,"text":"Till I shall see you in your soldier’s dress,"},{"n":6,"text":"Which will become you both, farewell."}]}]},{"type":"speech","speaker":"Mecaenas","blocks":[{"type":"verse","lines":[{"n":7,"text":"We shall,"},{"n":8,"text":"As I conceive the journey, be at the Mount"},{"n":9,"text":"Before you, Lepidus."}]}]},{"type":"speech","speaker":"Lepidus","blocks":[{"type":"verse","lines":[{"n":10,"text":"Your way is shorter;"},{"n":11,"text":"My purposes do draw me much about:"},{"n":12,"text":"You’ll win two days upon me."}]}]},{"type":"speech","speaker":"Mecaenas Agrippa","blocks":[{"type":"verse","lines":[{"n":13,"text":"Sir, good success!"}]}]},{"type":"speech","speaker":"Lepidus","blocks":[{"type":"verse","lines":[{"n":14,"text":"Farewell. Exeunt.","marks":[{"s":10,"e":17,"k":"em"}]}]}]}]}