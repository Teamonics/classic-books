{"schema":1,"ref":"3.8","work":"antony-and-cleopatra","title":"Act 3, Scene 8","prev":"3.7","next":"3.9","blocks":[{"type":"stage","text":"A plain near Actium."},{"type":"stage","text":"Enter Caesar, and Taurus, with his army, marching.","marks":[{"s":6,"e":12,"k":"strong"},{"s":18,"e":24,"k":"strong"}]},{"type":"speech","speaker":"Caesar","blocks":[{"type":"verse","lines":[{"n":1,"text":"Taurus!"}]}]},{"type":"speech","speaker":"Taurus","blocks":[{"type":"verse","lines":[{"n":2,"text":"My lord?"}]}]},{"type":"speech","speaker":"Caesar","blocks":[{"type":"verse","lines":[{"n":3,"text":"Strike not by land; keep whole: provoke not battle,"},{"n":4,"text":"Till we have done at sea. Do not exceed"},{"n":5,"text":"The prescript of this scroll: our fortune lies"},{"n":6,"text":"Upon this jump. Exeunt.","marks":[{"s":16,"e":23,"k":"em"}]}]}]}]}