{"schema":1,"ref":"3.9","work":"antony-and-cleopatra","title":"Act 3, Scene 9","prev":"3.8","next":"3.10","blocks":[{"type":"stage","text":"Another part of the plain."},{"type":"stage","text":"Enter Antony and Enobarbas.","marks":[{"s":6,"e":12,"k":"strong"},{"s":17,"e":26,"k":"strong"}]},{"type":"speech","speaker":"Antony","blocks":[{"type":"verse","lines":[{"n":1,"text":"Set we our squadrons on yond side o’ the hill,"},{"n":2,"text":"In eye of Caesar’s battle; from which place"},{"n":3,"text":"We may the number of the ships behold,"},{"n":4,"text":"And so proceed accordingly. Exeunt.","marks":[{"s":28,"e":35,"k":"em"}]}]}]}]}