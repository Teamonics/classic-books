{"schema":1,"ref":"4.5","work":"antony-and-cleopatra","title":"Act 4, Scene 5","prev":"4.4","next":"4.6","blocks":[{"type":"stage","text":"Alexandria. Antony’s camp.","marks":[{"s":12,"e":20,"k":"strong"}]},{"type":"stage","text":"Trumpets sound. Enter Antony and Eros; a Soldier meeting them.","marks":[{"s":22,"e":28,"k":"strong"},{"s":33,"e":37,"k":"strong"},{"s":41,"e":48,"k":"strong"}]},{"type":"speech","speaker":"Soldier","blocks":[{"type":"verse","lines":[{"n":1,"text":"The gods make this a happy day to Antony!"}]}]},{"type":"speech","speaker":"Antony","blocks":[{"type":"verse","lines":[{"n":2,"text":"Would thou and those thy scars had once prevail’d"},{"n":3,"text":"To make me fight at land!"}]}]},{"type":"speech","speaker":"Soldier","blocks":[{"type":"verse","lines":[{"n":4,"text":"Hadst thou done so,"},{"n":5,"text":"The kings that have revolted, and the soldier"},{"n":6,"text":"That has this morning left thee, would have still"},{"n":7,"text":"Follow’d thy heels."}]}]},{"type":"speech","speaker":"Antony","blocks":[{"type":"verse","lines":[{"n":8,"text":"Who’s gone this morning?"}]}]},{"type":"speech","speaker":"Soldier","blocks":[{"type":"verse","lines":[{"n":9,"text":"Who!"},{"n":10,"text":"One ever near thee: call for Enobarbus,"},{"n":11,"text":"He shall not hear thee; or from Caesar’s camp"},{"n":12,"text":"Say “I am none of thine.”"}]}]},{"type":"speech","speaker":"Antony","blocks":[{"type":"verse","lines":[{"n":13,"text":"What say’st thou?"}]}]},{"type":"speech","speaker":"Soldier","blocks":[{"type":"verse","lines":[{"n":14,"text":"Sir,"},{"n":15,"text":"He is with Caesar."}]}]},{"type":"speech","speaker":"Eros","blocks":[{"type":"verse","lines":[{"n":16,"text":"Sir, his chests and treasure"},{"n":17,"text":"He has not with him."}]}]},{"type":"speech","speaker":"Antony","blocks":[{"type":"verse","lines":[{"n":18,"text":"Is he gone?"}]}]},{"type":"speech","speaker":"Soldier","blocks":[{"type":"verse","lines":[{"n":19,"text":"Most certain."}]}]},{"type":"speech","speaker":"Antony","blocks":[{"type":"verse","lines":[{"n":20,"text":"Go, Eros, send his treasure after; do it;"},{"n":21,"text":"Detain no jot, I charge thee: write to him⁠—"},{"n":22,"text":"I will subscribe⁠—gentle adieus and greetings;"},{"n":23,"text":"Say that I wish he never find more cause"},{"n":24,"text":"To change a master. O, my fortunes have"},{"n":25,"text":"Corrupted honest men! Dispatch.⁠—Enobarbus! Exeunt.","marks":[{"s":44,"e":51,"k":"em"}]}]}]}]}