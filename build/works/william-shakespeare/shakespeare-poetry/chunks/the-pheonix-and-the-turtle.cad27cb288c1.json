{"schema":1,"ref":"the-pheonix-and-the-turtle","work":"shakespeare-poetry","title":"The Phoenix and the Turtle","prev":"the-passionate-pilgrim","next":"sonnets","blocks":[{"type":"verse","lines":[{"n":1,"text":"Let the bird of loudest lay,"},{"n":2,"text":"On the sole Arabian tree,"},{"n":3,"text":"Herald sad and trumpet be,"},{"n":4,"text":"To whose sound chaste wings obey."}]},{"type":"verse","lines":[{"n":5,"text":"But thou shrieking harbinger,"},{"n":6,"text":"Foul precurrer of the fiend,"},{"n":7,"text":"Augur of the fever’s end,"},{"n":8,"text":"To this troop come thou not near!"}]},{"type":"verse","lines":[{"n":9,"text":"From this session interdict"},{"n":10,"text":"Every fowl of tyrant wing,"},{"n":11,"text":"Save the eagle, feather’d king:"},{"n":12,"text":"Keep the obsequy so strict."}]},{"type":"verse","lines":[{"n":13,"text":"Let the priest in surplice white,"},{"n":14,"text":"That defunctive music can,"},{"n":15,"text":"Be the death-divining swan,"},{"n":16,"text":"Lest the requiem lack his right."}]},{"type":"verse","lines":[{"n":17,"text":"And thou treble-dated crow,"},{"n":18,"text":"That thy sable gender makest"},{"n":19,"text":"With the breath thou givest and takest,"},{"n":20,"text":"’Mongst our mourners shalt thou go."}]},{"type":"verse","lines":[{"n":21,"text":"Here the anthem doth commence:"},{"n":22,"text":"Love and constancy is dead;"},{"n":23,"text":"Phoenix and the turtle fled"},{"n":24,"text":"In a mutual flame from hence."}]},{"type":"verse","lines":[{"n":25,"text":"So they loved, as love in twain"},{"n":26,"text":"Had the essence but in one;"},{"n":27,"text":"Two distincts, division none:"},{"n":28,"text":"Number there in love was slain."}]},{"type":"verse","lines":[{"n":29,"text":"Hearts remote, yet not asunder;"},{"n":30,"text":"Distance, and no space was seen"},{"n":31,"text":"’Twixt the turtle and his queen:"},{"n":32,"text":"But in them it were a wonder."}]},{"type":"verse","lines":[{"n":33,"text":"So between them love did shine,"},{"n":34,"text":"That the turtle saw his right"},{"n":35,"text":"Flaming in the phoenix’ sight;"},{"n":36,"text":"Either was the other’s mine."}]},{"type":"verse","lines":[{"n":37,"text":"Property was thus appalled,"},{"n":38,"text":"That the self was not the same;"},{"n":39,"text":"Single nature’s double name"},{"n":40,"text":"Neither two nor one was called."}]},{"type":"verse","lines":[{"n":41,"text":"Reason, in itself confounded,"},{"n":42,"text":"Saw division grow together,"},{"n":43,"text":"To themselves yet either neither,"},{"n":44,"text":"Simple were so well compounded,"}]},{"type":"verse","lines":[{"n":45,"text":"That it cried, How true a twain"},{"n":46,"text":"Seemeth this concordant one!"},{"n":47,"text":"Love hath reason, reason none,"},{"n":48,"text":"If what parts can so remain."}]},{"type":"verse","lines":[{"n":49,"text":"Whereupon it made this threne"},{"n":50,"text":"To the phoenix and the dove,"},{"n":51,"text":"Co-supremes and stars of love,"},{"n":52,"text":"As chorus to their tragic scene."}]},{"type":"para","n":1,"text":"Threnos.","marks":[{"s":0,"e":8,"k":"strong"}]},{"type":"verse","lines":[{"n":53,"text":"Beauty, truth, and rarity,"},{"n":54,"text":"Grace in all simplicity,"},{"n":55,"text":"Here enclosed in cinders lie."}]},{"type":"verse","lines":[{"n":56,"text":"Death is now the phoenix’ nest;"},{"n":57,"text":"And the turtle’s loyal breast"},{"n":58,"text":"To eternity doth rest,"}]},{"type":"verse","lines":[{"n":59,"text":"Leaving no posterity:"},{"n":60,"text":"’Twas not their infirmity,"},{"n":61,"text":"It was married chastity."}]},{"type":"verse","lines":[{"n":62,"text":"Truth may seem, but cannot be;"},{"n":63,"text":"Beauty brag, but ’tis not she;"},{"n":64,"text":"Truth and beauty buried be."}]},{"type":"verse","lines":[{"n":65,"text":"To this urn let those repair"},{"n":66,"text":"That are either true or fair;"},{"n":67,"text":"For these dead birds sigh a prayer."}]}]}